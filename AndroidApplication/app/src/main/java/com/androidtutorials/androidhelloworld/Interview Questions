// 1️⃣2️⃣ Fold Real Interview Question
// ============================================================

/*
Q: Convert list into comma separated string using fold
*/

fun foldStringExample() {

    val words = listOf("A", "B", "C")

    val result = words.fold("") { acc, word ->
        if (acc.isEmpty()) word else "$acc,$word"
    }

}
