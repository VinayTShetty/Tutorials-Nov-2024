// ============================================================
// 🔟 Chunked & Windowed
// ============================================================

fun chunkedWindowedExample() {

    val numbers = listOf(1, 2, 3, 4, 5)

    val chunked = numbers.chunked(2)
    // [[1,2], [3,4], [5]]

    val windowed = numbers.windowed(3)
    // [[1,2,3], [2,3,4], [3,4,5]]
}


