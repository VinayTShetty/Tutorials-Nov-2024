/*
==================== PRODUCED STATE – COMPLETE EXPLANATION ====================

DEFINITION:
--------------------------------------------------------------------------------
Produced State is used when UI state is produced by:
- async work
- time
- Flow
- external systems (API, DB, sensors)

The UI does NOT control or mutate this state.
UI only reacts to changes.

--------------------------------------------------------------------------------
CORE IDEA:
"If the output changes over time or depends on something external,
and UI should only observe it → use Produced State."

================================================================================
WHY NORMAL VARIABLES OR METHODS ARE NOT ENOUGH
================================================================================
Composable functions:
- Can re-run MANY times
- Must be fast
- Must NOT perform side-effects directly

Calling suspend / heavy work directly inside a Composable causes:
❌ Multiple API calls
❌ UI freeze
❌ Memory leaks
❌ Crashes

Produced State solves this safely.

================================================================================
EXAMPLE 1: PRODUCED STATE WITH TIME (TIMER)
================================================================================
*/

@Composable
fun ProducedStateTimerExample() {

    /*
     * This state is PRODUCED by TIME.
     * UI does NOTHING to update it.
     *
     * - Runs in a coroutine
     * - Updates automatically every second
     * - Cancels automatically when composable leaves screen
     */
    val seconds by produceState(initialValue = 0) {
        var counter = 0
        while (true) {
            delay(1000)
            value = counter++
        }
    }

    Column(
        modifier = Modifier.fillMaxSize(),
        verticalArrangement = Arrangement.Center,
        horizontalAlignment = Alignment.CenterHorizontally
    ) {
        Text(
            text = "Timer: $seconds seconds",
            fontSize = 26.sp,
            color = MaterialTheme.colorScheme.primary
        )
    }
}

/*
================================================================================
❌ WRONG WAY (DO NOT USE THIS)
================================================================================
*/

@Composable
fun WrongExample() {

    /*
     * ❌ ILLEGAL AND DANGEROUS
     *
     * Reasons:
     * - Composables can re-run
     * - API will be called again and again
     * - UI may freeze
     * - App may crash
     */
    val user = fetchUserFromAPI() // ❌ suspend call inside composable
    Text(user)
}

/*
================================================================================
FINAL CONCLUSION (CORE IDEA)
================================================================================

Produced State is used when:
- State is generated by background work
- State changes over time
- State depends on external systems
- UI should only react, not control

Normal variables or normal methods are NOT enough
for async or time-based state.

================================================================================
WHEN TO USE produceState
================================================================================
✅ API calls
✅ suspend functions
✅ Flow collection
✅ Timers
✅ Database updates
✅ Sensor data

================================================================================
WHEN NOT TO USE produceState
================================================================================
❌ Simple calculations
❌ UI-controlled state (button clicks)
❌ Derived values from existing state

================================================================================
KEY RULE (MEMORIZE THIS)
================================================================================
"If UI is waiting for data → use Produced State
 If UI itself changes the value → use Mutable State"

================================================================================
ONE-LINE INTERVIEW ANSWER
================================================================================
Produced State allows Compose to safely run suspend or long-running operations
and automatically update UI without breaking recomposition rules.

================================================================================
END
================================================================================
*/
