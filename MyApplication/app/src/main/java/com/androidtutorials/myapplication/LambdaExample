// Trailing Lambda

/**
  If  the last parameter of the funciton , then we can write that function outside the function.
 */

package com.androidtutorials.myapplication

fun main() {
    demoLambda(
        "Calling Lambda") {
            a: Int, b: Int -> 100
    }
}

fun demoLambda(text: String, operation: (Int, Int) -> Int) {
    println("Hello World")
}

